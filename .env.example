# ═══════════════════════════════════════════════════════
#  AOSP Code Search — environment configuration template
#
#  Usage: copy to .env and edit as needed
#    cp .env.example .env
#
#  Syntax:
#    KEY=VALUE            plain assignment
#    KEY="quoted value"   quotes are auto-stripped
#    export KEY=VALUE     export prefix is auto-ignored
#    # comment            full-line comment
#    KEY=value # comment  inline comments are auto-stripped
#
#  Note: multi-line values and variable interpolation ($VAR) are NOT supported.
#  Environment variables passed on the command line always override .env values.
# ═══════════════════════════════════════════════════════

# ─── Service URLs ────────────────────────────────────
# Used by testing scripts and bare-process MCP to reach services.
# In Docker-in-Docker, use Docker DNS names (e.g. http://sourcepilot-gateway:9000).
SOURCEPILOT_URL=http://localhost:9000
MCP_URL=http://localhost:8888/mcp
SP_COCKPIT_URL=http://localhost:9100

# ─── Zoekt ───────────────────────────────────────────
# Zoekt webserver URL
ZOEKT_URL=http://localhost:6070
# Zoekt index directory (used by run_all.sh to start sparse-index-zoekt)
ZOEKT_INDEX_PATH=/opt/aosp/aosp_project/.repo/.zoekt/

# ─── Multi-project ───────────────────────────────────
# Project registry path (YAML; defines zoekt port and index dir per AOSP checkout)
# run_all.sh starts an independent zoekt-webserver per project.
# Leave empty or point to a non-existent file to fall back to single-project mode
# (uses ZOEKT_INDEX_PATH + ZOEKT_URL).
PROJECTS_CONFIG_PATH=config/projects.yaml

# ─── Index container source mount ────────────────────
# dense/graph index containers (deploy/docker-compose.yml indexer profile)
# mount this directory read-only at /src inside the container.
# The wrapper script translates host paths to /src/<subpath> before passing
# them to the in-container build_*_index.py.
# Note: the AOSP_ROOT default in scripts/build_dense_index_batch.sh should match.
AOSP_SOURCE_ROOT=/opt/aosp/aosp_project

# ─── Zoekt Docker ────────────────────────────────────
# Repository path in Docker mode (bind-mounted into indexserver)
# ZOEKT_REPO_PATH=/opt/aosp/aosp_project/.repo
# Zoekt host-port mapping in Docker mode
# ZOEKT_PORT=6070

# ─── SourcePilot ─────────────────────────────────────
# Context window around hits: how many lines above/below each match
# DEFAULT_CONTEXT_LINES=20
# Enable BM25 scoring
# USE_BM25_SCORING=true
# Context lines returned by the Zoekt backend
# NUM_CONTEXT_LINES=3

# ─── Gateway container ───────────────────────────────
# Gateway container host-port mapping (compose mode)
SOURCEPILOT_PORT=9000
# Install qdrant-client when building the gateway image (set true for dense)
GATEWAY_INSTALL_DENSE=false

# ─── Natural-language enhancement (NL) ───────────────
NL_ENABLED=true
NL_MODEL=auto
NL_API_KEY=your-nl-api-key-here
NL_API_BASE=https://your-llm-endpoint/v1
# NL request timeout (seconds)
# NL_TIMEOUT=10.0
# NL cache TTL (seconds)
# NL_CACHE_TTL=86400

# ─── Dense (vector) retrieval ────────────────────────
# Enable the dense (semantic vector) search lane
DENSE_ENABLED=false
# Qdrant vector DB URL
# DENSE_VECTOR_DB_URL=http://localhost:6333
# Qdrant collection name
# DENSE_COLLECTION_NAME=aosp_code
# Embedding service URL
# DENSE_EMBEDDING_URL=http://localhost:8080/v1
# Embedding model name
# DENSE_EMBEDDING_MODEL=unixcoder-base
# Embedding dimension
# DENSE_EMBEDDING_DIM=768
# Dense top-K results
# DENSE_TOP_K=20
# Dense rerank boost score
# DENSE_RERANK_BOOST=0.05

# ─── ONNX Embedding Server ──────────────────────────
# OMP_NUM_THREADS=18
# EMBEDDING_MAX_BATCH_SIZE=64
# Per-corpus embedding model (used by gateway for model routing)
# DENSE_EMBEDDING_MODEL_CODE=nomic-ai/CodeRankEmbed
# DENSE_EMBEDDING_MODEL_ZH=BAAI/bge-base-zh-v1.5

# CODE_EMBEDDING_MODEL: which code-embedding model to load at server boot.
# Valid values: nomic-ai/CodeRankEmbed (default), microsoft/unixcoder-base
# bge-base-zh-v1.5 (Chinese auxiliary) is always loaded regardless.
# Switching requires server restart AND a project that uses a matching collection.
CODE_EMBEDDING_MODEL=nomic-ai/CodeRankEmbed

# ─── Service launch mode ─────────────────────────────
# Whether to start MCP / SP Cockpit inside Docker (true) or as bare processes (false).
# SourcePilot and infrastructure (zoekt/qdrant/neo4j) always run in Docker.
MCP_DOCKER=false
SP_COCKPIT_DOCKER=false

# ─── MCP Server ──────────────────────────────────────
# Transport mode: streamable-http or stdio (used by run_all.sh)
MCP_TRANSPORT=streamable-http
# MCP listen port (streamable-http mode)
MCP_PORT=8888
# REQUIRED for streamable_http transport (process exits 1 if empty)
MCP_AUTH_TOKEN=

# ─── Audit log ───────────────────────────────────────
# Master audit switch
# AUDIT_ENABLED=true
# Slow-query threshold (ms)
# AUDIT_SLOW_QUERY_MS=3000
# Audit log file path (must be absolute or consistently resolvable by all processes)
# SourcePilot writes to this file; sp-cockpit reads it via SP_COCKPIT_AUDIT_LOG_PATH.
# When empty, run_sourcepilot.sh / run_sp_cockpit.sh default to $PROJ_ROOT/audit.log.
# AUDIT_LOG_FILE=./audit.log
# Log path read by sp-cockpit (should match AUDIT_LOG_FILE)
# SP_COCKPIT_AUDIT_LOG_PATH=./audit.log
# sp-cockpit SQLite mirror DB path (default: sp-cockpit/data/audit.db)
# SP_COCKPIT_AUDIT_DB_PATH=./sp-cockpit/data/audit.db
# sp-cockpit listen port / host
# SP_COCKPIT_PORT=9100
# SP_COCKPIT_HOST=0.0.0.0
# Periodic summary interval (seconds); 0 disables
# AUDIT_SUMMARY_INTERVAL=300

# ─── Indexing Admin ──────────────────────────────────
# Internal auth token shared by wrapper scripts and sp-cockpit.
# Replace with a sufficiently long random string in production.
INDEXING_INTERNAL_TOKEN=change-me-to-random-token

# ─── Graph (Neo4j) retrieval ─────────────────────────
# Enable graph (Neo4j) retrieval lane
# GRAPH_ENABLED=false
# Neo4j Bolt connection URI
# GRAPH_NEO4J_URI=bolt://localhost:7687
# Neo4j username
# GRAPH_NEO4J_USER=neo4j
# Neo4j password
# GRAPH_NEO4J_PASSWORD=sourcepilot
# Graph retrieval lane timeout (ms)
# GRAPH_LANE_TIMEOUT_MS=2000
